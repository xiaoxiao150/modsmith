{
  "name": "modsmith",
  "version": "0.6.2",
  "description": "Turn Fabric mod jars into semantic manifests + measured registry ids for mineflayer AI companions.",
  "type": "module",
  "license": "MIT",
  "author": "modsmith contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoxiao150/modsmith.git"
  },
  "homepage": "https://github.com/xiaoxiao150/modsmith#readme",
  "bugs": {
    "url": "https://github.com/xiaoxiao150/modsmith/issues"
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "fabric",
    "mod",
    "manifest",
    "calibration",
    "bot",
    "minecraft-bot",
    "ai-companion",
    "game-ai",
    "semantic-layer"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "src/",
    "schema/",
    "templates/",
    "sidesheets/",
    "types/",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "modsmith": "./bin/modsmith.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.mjs"
    }
  },
  "types": "./types/index.d.ts",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "mineflayer": "^4.37.1",
    "vec3": "^0.2.0"
  },
  "peerDependencies": {
    "mineflayer-pathfinder": "^2.4.5"
  },
  "peerDependenciesMeta": {
    "mineflayer-pathfinder": {
      "optional": true
    }
  }
}
