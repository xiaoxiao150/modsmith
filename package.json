{
  "name": "modsmith",
  "version": "0.3.0",
  "description": "Turn a Fabric mod jar into a semantic manifest any mineflayer bot can use",
  "type": "module",
  "license": "MIT",
  "author": "modsmith contributors",
  "keywords": [
    "minecraft",
    "mineflayer",
    "fabric",
    "mod",
    "manifest",
    "calibration",
    "bot"
  ],
  "files": [
    "bin/",
    "src/",
    "schema/",
    "templates/",
    "sidesheets/",
    "types/",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "modsmith": "./bin/modsmith.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.mjs"
    }
  },
  "types": "./types/index.d.ts",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "mineflayer": "^4.37.1",
    "vec3": "^0.2.0"
  },
  "peerDependencies": {
    "mineflayer-pathfinder": "^2.4.5"
  },
  "peerDependenciesMeta": {
    "mineflayer-pathfinder": {
      "optional": true
    }
  }
}
